# ---------------------------------------------------------------------------
# MathHack Backend Configuration.
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Environment: development | test | production
NODE_ENV=development
PORT=4000

# MongoDB URI (MongoDB Atlas or Replica Set)
# Example Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mathhack?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/mathhack?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/mathhack

# Exact origins of the Frontend React app (used for CORS and CSRF origin checks)
FRONTEND_URL=http://localhost:5173
CORS_EXTRA_ORIGINS=http://localhost:5174

# Public URL of this backend server
BACKEND_PUBLIC_URL=http://localhost:4000

# Session Secret (at least 32 random characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters-secret
SESSION_TTL_HOURS=12

# Cookie configuration
# Leave COOKIE_DOMAIN empty for localhost or subdomains
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# Number of reverse proxies in front of backend (1 on Render / Railway / Nginx, 0 locally)
TRUST_PROXY=0

# Initial host account (used by `npm run create-host`)
HOST_INITIAL_NAME=Host Admin
HOST_INITIAL_EMAIL=admin@college.edu
HOST_INITIAL_PASSWORD=HostAdmin#2026

# Optional: Redis connection for multi-instance scaling (leave empty for single-instance)
REDIS_URL=

# Optional: Roster verification
ROSTER_ENFORCED=false

# Development only (do not use in production)
RATE_LIMIT_DISABLED=false
