{
  "name": "mathhack-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "create-host": "tsx scripts/createHost.ts",
    "reset-host-pass": "tsx scripts/resetHostPassword.ts",
    "users": "tsx scripts/manageUsers.ts",
    "validate-env": "tsx scripts/validateEnvironment.ts",
    "seed:dev": "tsx database/seed/developmentSeed.ts",
    "templates": "tsx scripts/generateTemplates.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "argon2": "^0.44.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^5.6.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "hono": "^4.13.16",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "multer": "^2.0.2",
    "redis": "^5.8.0",
    "typescript": "~5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.35.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.11"
  }
}
